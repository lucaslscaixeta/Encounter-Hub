# Copie este arquivo para .env e preencha. Nunca envie o .env para o git.

# ===== Supabase =====

# Connection string do banco: botão "Connect" > aba "Direct" >
# "Shared pooler" (porta 5432, funciona em qualquer rede). Troque
# [YOUR-PASSWORD] pela senha do banco, sem os colchetes. Caracteres
# especiais na senha precisam ser codificados (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Botão "Connect" > aba "Server": copie SUPABASE_URL e SUPABASE_SECRET_KEY.
# (SUPABASE_PUBLISHABLE_KEY e SUPABASE_JWKS_URL não são usadas.)
# A chave secreta ignora as regras de acesso: use só no backend,
# nunca no frontend.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=

# Opcional: nome do bucket do Storage onde ficam mapas e tokens
# (padrão "encounter-hub", criado automaticamente no primeiro envio).
SUPABASE_BUCKET=encounter-hub

# ===== E-mail =====
# Dados da conta Gmail que vai enviar os e-mails de confirmação.

# E-mail completo da conta Gmail.
MAIL_USERNAME=seu-email@gmail.com

# Senha de app de 16 caracteres (não é a senha normal da conta).
# Gere em https://myaccount.google.com/apppasswords
MAIL_PASSWORD=

# Remetente exibido nos e-mails. Use o mesmo e-mail de MAIL_USERNAME.
MAIL_DEFAULT_SENDER=Encounter Hub <seu-email@gmail.com>
